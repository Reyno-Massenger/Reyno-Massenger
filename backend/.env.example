# Reyno Messenger Lite — Environment Configuration
# Default database uses local SQLite for zero-config deployment.
# For MySQL/MariaDB (cPanel or VPS), uncomment and configure DATABASE_URL:
# DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/reyno_lite
DATABASE_URL=sqlite:///reyno_lite.db

# Cryptographic secrets (auto-generated by install.sh / cpanel-setup.sh)
SECRET_KEY=replace-with-a-64-char-random-secret-key
JWT_SECRET_KEY=replace-with-a-different-64-char-jwt-secret

# Minimal Admin Panel credentials (only for adding/removing users & clearing storage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Media upload directory & retention policy
UPLOAD_FOLDER=uploads
RETENTION_HOURS=72
VIDEO_MAX_BYTES=10485760
MAX_CONTENT_LENGTH=26214400

# HTTPS is recommended but NOT required. Keep false so the site also works
# on plain HTTP (LAN / Iran national-network). HSTS is only sent over HTTPS.
FORCE_HTTPS=false
